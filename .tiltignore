**/.autogenerated/*.autogenerated.json
**/.autogenerated/*.autogenerated.yml
**/.autogenerated/*.autogenerated.toml

# Logs
**/*.log
**/logs

# Test outputs
**/test-results
**/playwright-report
**/.nyc_output

# Cache directories
