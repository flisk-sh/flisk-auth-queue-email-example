# =============================================================================
#
# This file tells Tilt which directories to ignore during file watching.
# Prevents fsnotify buffer overflow and reduces unnecessary rebuilds.
#
# =============================================================================

# Dependency directories
**/node_modules

# Build outputs
**/dist
**/build
**/out
**/.output

# Version control
**/.git

# Generated files
**/.prisma
**/.turbo
**/coverage
